# Environment variables template
# Copy this file to .env.local and fill in your values

# MongoDB
DATABASE_URL=mongodb://localhost:27017/packlite
# Or use MongoDB Atlas: DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/packlite

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-secret-key-here

# AWS S3 (for gear images)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=packlite-gear-images

# Public URL (for sharing features)
NEXT_PUBLIC_APP_URL=http://localhost:3000
