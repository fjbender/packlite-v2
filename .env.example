# Environment variables template
# Copy this file to .env.local and fill in your values

# MongoDB Configuration
# Option 1: Local MongoDB (no authentication)
# DATABASE_URL=mongodb://localhost:27017/packlite

# Option 2: Docker Compose MongoDB (with authentication)
DATABASE_URL=mongodb://packlite_admin:packlite_password@localhost:27017/packlite?authSource=admin

# Option 3: MongoDB Atlas (cloud)
# DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/packlite?retryWrites=true&w=majority

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-secret-key-here-use-openssl-rand-base64-32

# AWS S3 (for gear images) - Optional for now
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=packlite-gear-images

# Public URL (for sharing features)
NEXT_PUBLIC_APP_URL=http://localhost:3000
